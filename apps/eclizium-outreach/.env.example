# ---------------------------------------------------------------------------
# ECLIZIUM Outreach — environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_dev?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Optional locally;
# required when DATABASE_URL points at a connection pooler (PgBouncer/Neon).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_dev?schema=public

# Auth — 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-32-random-bytes-base64
# Session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API — SERVER-SIDE ONLY.
# Never prefix any of these with NEXT_PUBLIC_.
# While unset, the messaging channel reports status NOT_CONFIGURED.
#
# Token permissions required by the Meta app:
#   whatsapp_business_messaging   — send messages
#   whatsapp_business_management  — read/sync templates
# ---------------------------------------------------------------------------

# Used when a channel's credential source is ENVIRONMENT (single-tenant
# deployment). Workspaces configured with their own credential store this
# encrypted in the database instead — see docs/adr/0011.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Webhook. Both are REQUIRED for POST /api/webhooks/meta/whatsapp to accept
# anything: without META_APP_SECRET the endpoint refuses every delivery rather
# than processing unverified events. Set META_WEBHOOK_VERIFY_TOKEN to any random
# string and paste the same value into the Meta app's webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Graph API version used to build every request URL. Configurable so that
# moving to a new version is a deliberate change, not a code edit.
META_GRAPH_API_VERSION=v21.0

# Optional. 32 bytes, base64 — the key used to encrypt per-workspace access
# tokens at rest (AES-256-GCM). When absent, the key is derived from
# AUTH_SECRET via HKDF with a dedicated label, so no extra variable is
# mandatory. Set it explicitly to rotate credential encryption independently
# of session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_CREDENTIAL_KEY=

# ---------------------------------------------------------------------------
# Worker de envio
# ---------------------------------------------------------------------------

# Shared secret for POST /api/internal/worker/tick, used by a cron scheduler in
# serverless deployments. REQUIRED for that endpoint to accept anything: without
# it the route refuses every request rather than running unauthenticated. At
# least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Not needed when running `npm run worker` as a long-lived process.
WORKER_TOKEN=

# Runs the send worker INSIDE the web server process. Opt-in, off by default.
# For single-instance deployments (Render, Railway, a VM, Docker) where running
# a second process is inconvenient. Do NOT use on serverless — there is no
# long-lived process there; use the cron endpoint instead.
# Running several workers at once is safe (SKIP LOCKED leasing), so this can
# coexist with `npm run worker`.
RUN_WORKER_IN_PROCESS=false

# Test database used by `npm test` (integration suites).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_test?schema=public
