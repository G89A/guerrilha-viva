# ---------------------------------------------------------------------------
# ECLIZIUM Outreach — environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_dev?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Optional locally;
# required when DATABASE_URL points at a connection pooler (PgBouncer/Neon).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_dev?schema=public

# Auth — 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-32-random-bytes-base64
# Session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API — SERVER-SIDE ONLY.
# Never prefix any of these with NEXT_PUBLIC_.
# While unset, the messaging channel reports status NOT_CONFIGURED.
# Consumed from SPRINT 2 onwards.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Test database used by `npm test` (integration suites).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eclizium_test?schema=public
