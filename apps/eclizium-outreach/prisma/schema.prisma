// ECLIZIUM Outreach — data model.
//
// Multi-tenancy rule: every business entity carries `workspaceId`. The value is
// always derived server-side from the authenticated session (see
// src/lib/auth/guards.ts); it is never read from client input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions     Session[]
  members      WorkspaceMember[]
  auditLogs    AuditLog[]
  suppressions SuppressionEntry[]
  messages     Message[]
  campaigns    Campaign[]

  @@map("users")
}

/// Opaque, server-issued session. Only the SHA-256 hash of the token is stored,
/// so a database dump cannot be replayed as a login.
model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  activeWorkspaceId String?   @map("active_workspace_id")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Região ISO 3166-1 alpha-2 usada para normalizar telefones sem código de
  /// país (ver features/contacts/phone.ts).
  defaultPhoneRegion String @default("BR") @map("default_phone_region")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            WorkspaceMember[]
  sessions           Session[]
  contacts           Contact[]
  contactLists       ContactList[]
  tags               Tag[]
  suppressionEntries SuppressionEntry[]
  channels           MessagingChannel[]
  templates          MessageTemplate[]
  campaigns          Campaign[]
  conversations      Conversation[]
  messages           Message[]
  webhookEvents      WebhookEvent[]
  auditLogs          AuditLog[]
  consents           ContactConsent[]
  campaignRecipients CampaignRecipient[]
  jobs               Job[]
  rateLimitBuckets   RateLimitBucket[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

enum ContactStatus {
  ACTIVE
  ARCHIVED
  /// Telefone comprovadamente inválido: não entra em campanha, mas o registro
  /// é preservado para auditoria e para não ser reimportado como novo.
  INVALID
}

model Contact {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  /// Telefone exatamente como informado, preservado para conferência humana.
  phone       String?
  /// Forma canônica E.164. É a identidade do contato dentro do workspace.
  phoneE164   String  @map("phone_e164")
  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  email       String?
  company     String?
  segment     String?
  city        String?
  state       String?
  country     String?
  locale      String?
  timezone    String?
  notes       String?
  /// Colunas extras vindas de importação, sem esquema fixo.
  attributes  Json    @default("{}")

  status     ContactStatus @default(ACTIVE)
  source     String?
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consents      ContactConsent[]
  listMembers   ContactListMember[]
  tags          ContactTag[]
  suppressions  SuppressionEntry[]
  recipients    CampaignRecipient[]
  conversations Conversation[]
  messages      Message[]

  @@unique([workspaceId, phoneE164])
  /// Alvo das foreign keys compostas das tabelas de junção: garante no banco
  /// que um vínculo nunca cruza workspaces.
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, city])
  @@index([workspaceId, source])
  @@index([workspaceId, company])
  @@index([phoneE164])
  @@map("contacts")
}

enum ConsentChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum ConsentSource {
  MANUAL
  CSV_IMPORT
  WEB_FORM
  API
  INBOUND_MESSAGE
  PROVIDER_EVENT
  OTHER
}

model ContactConsent {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  contactId      String         @map("contact_id")
  channel        ConsentChannel
  status         ConsentStatus  @default(UNKNOWN)
  source         ConsentSource  @default(MANUAL)
  /// Referência à prova do consentimento (URL do formulário, id do registro
  /// de origem, protocolo). Texto livre, nunca um segredo.
  proofReference String?        @map("proof_reference")
  capturedAt     DateTime?      @map("captured_at")
  revokedAt      DateTime?      @map("revoked_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Foreign key COMPOSTA: um consentimento não pode apontar para um contato de
  /// outro workspace, mesmo que um serviço esqueça o filtro.
  contact   Contact   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([workspaceId, channel, status])
  @@map("contact_consents")
}

model ContactList {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ContactListMember[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("contact_lists")
}

model ContactListMember {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  listId      String   @map("list_id")
  contactId   String   @map("contact_id")
  createdAt   DateTime @default(now()) @map("created_at")

  /// Mesmo racional das ContactTag: o vínculo não pode cruzar workspaces.
  list    ContactList @relation(fields: [workspaceId, listId], references: [workspaceId, id], onDelete: Cascade)
  contact Contact     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
  @@index([workspaceId])
  @@map("contact_list_members")
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("tags")
}

model ContactTag {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  tagId       String   @map("tag_id")
  contactId   String   @map("contact_id")
  createdAt   DateTime @default(now()) @map("created_at")

  /// Foreign keys COMPOSTAS: o PostgreSQL recusa vincular uma tag de um
  /// workspace a um contato de outro, mesmo que o serviço erre.
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)
  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([tagId, contactId])
  @@index([contactId])
  @@index([workspaceId])
  @@map("contact_tags")
}

enum SuppressionReason {
  OPT_OUT
  BLOCKED
  COMPLAINT
  INVALID
  MANUAL
}

/// A suppressed phone number must never receive outbound campaign traffic.
/// Keyed by phone (not contact) so a re-imported contact stays suppressed.
model SuppressionEntry {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  /// Vínculo com o contato, para histórico e UI. Anulável de propósito: a
  /// supressão sobrevive à remoção do contato.
  contactId   String?           @map("contact_id")
  /// Chave durável. Um contato reimportado com o mesmo número continua
  /// suprimido, mesmo que o registro anterior não exista mais.
  phoneE164   String            @map("phone_e164")
  channel     ConsentChannel    @default(WHATSAPP)
  reason      SuppressionReason
  notes       String?
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// FK simples, e não composta: `onDelete: SetNull` não pode anular
  /// `workspaceId`, que é obrigatório. A supressão PRECISA sobreviver à
  /// remoção do contato, então a garantia de tenant aqui vem do serviço —
  /// `suppressContact` valida a posse com `getContactOrThrow` antes de escrever.
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, channel, phoneE164])
  @@index([workspaceId, createdAt])
  @@index([contactId])
  @@map("suppression_entries")
}

// ---------------------------------------------------------------------------
// Messaging channels & templates
// ---------------------------------------------------------------------------

enum ChannelProvider {
  META
}

/// Canal dentro do provider. Hoje só WhatsApp; o enum existe para que um
/// segundo canal não exija reescrever o modelo.
enum ChannelKind {
  WHATSAPP
}

/// De onde o access token é lido em tempo de execução (ver ADR 0011).
enum CredentialSource {
  /// `META_ACCESS_TOKEN` do ambiente — deploy de um único tenant.
  ENVIRONMENT
  /// Cifrado em repouso no banco, por workspace.
  ENCRYPTED
}

enum ChannelEnvironment {
  TEST
  PRODUCTION
}

enum ChannelStatus {
  /// Faltam credenciais ou identificadores.
  NOT_CONFIGURED
  /// Verificado contra a Graph API e funcionando.
  CONNECTED
  /// Credencial recusada pela Meta (token inválido, expirado, sem permissão).
  INVALID
  /// Desligado deliberadamente por um administrador.
  DISCONNECTED
  /// Falha inesperada na última verificação.
  ERROR
}

model MessagingChannel {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  provider    ChannelProvider    @default(META)
  channel     ChannelKind        @default(WHATSAPP)
  status      ChannelStatus      @default(NOT_CONFIGURED)
  environment ChannelEnvironment @default(TEST)
  displayName String             @map("display_name")

  /// Identificadores da Meta. São dados de administração, não segredos.
  wabaId             String? @map("waba_id")
  phoneNumberId      String? @map("phone_number_id")
  displayPhoneNumber String? @map("display_phone_number")
  verifiedName       String? @map("verified_name")
  phoneE164          String? @map("phone_e164")

  /// Versão da Graph API usada por este canal. Configurável por workspace para
  /// que uma migração de versão não seja um big bang.
  graphApiVersion   String @default("v21.0") @map("graph_api_version")
  /// Vazão de envio deste canal. Ajustável ao tier da conta na Meta; existe
  /// para respeitar o limite do provider, não para disfarçar automação.
  messagesPerSecond Float  @default(10) @map("messages_per_second")
  sendBurst         Float  @default(20) @map("send_burst")

  credentialSource  CredentialSource @default(ENVIRONMENT) @map("credential_source")
  /// AES-256-GCM. Só é preenchido quando credentialSource = ENCRYPTED.
  accessTokenCipher String?          @map("access_token_cipher")
  /// Prefixo/sufixo mascarado + hash curto, para o operador reconhecer qual
  /// token está em uso sem que o valor exista fora do servidor.
  tokenFingerprint  String?          @map("token_fingerprint")

  lastError      String?   @map("last_error")
  lastErrorCode  String?   @map("last_error_code")
  connectedAt    DateTime? @map("connected_at")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates     MessageTemplate[]
  campaigns     Campaign[]
  conversations Conversation[]
  messages      Message[]

  /// Um canal por (workspace, provider, tipo de canal): a integração pertence
  /// ao workspace e não pode ser compartilhada.
  @@unique([workspaceId, provider, channel])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("messaging_channels")
}

/// Status NORMALIZADO. O valor bruto do provider fica em
/// `MessageTemplate.providerStatus`, para que um estado novo da Meta caia em
/// UNKNOWN sem quebrar a aplicação, sem perder a informação original.
enum TemplateStatus {
  UNKNOWN
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

/// Um template que sumiu da Meta não é apagado: ele deixa de estar disponível
/// e o histórico local sobrevive (ver ADR 0013).
enum TemplateAvailability {
  AVAILABLE
  UNAVAILABLE
}

/// Formato do cabeçalho, quando o template tem um.
enum TemplateHeaderFormat {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  LOCATION
  UNKNOWN
}

enum TemplateCategory {
  UNKNOWN
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// Mirrors provider-owned template state. `status` is only ever written from a
/// provider response — never set locally (see docs/adr/0005).
model MessageTemplate {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  channelId   String          @map("channel_id")
  provider    ChannelProvider @default(META)

  /// Id do template na Meta. Chave de reconciliação da sincronização.
  providerTemplateId String? @map("provider_template_id")

  name     String
  language String

  category         TemplateCategory @default(UNKNOWN)
  status           TemplateStatus   @default(UNKNOWN)
  /// Valores exatamente como vieram da Meta, sem normalização.
  providerStatus   String?          @map("provider_status")
  providerCategory String?          @map("provider_category")

  headerFormat TemplateHeaderFormat? @map("header_format")
  headerText   String?               @map("header_text")
  body         String
  footerText   String?               @map("footer_text")
  /// Botões normalizados: [{ type, text, url?, phoneNumber? }].
  buttons      Json                  @default("[]")
  /// Componentes crus da Meta, preservados para renderização futura.
  components   Json                  @default("[]")

  /// Placeholders detectados no corpo/cabeçalho: [{ key: "1", component: "body" }].
  variables     Json @default("[]")
  variableCount Int  @default(0) @map("variable_count")

  qualityScore      String?   @map("quality_score")
  rejectedReason    String?   @map("rejected_reason")
  providerCreatedAt DateTime? @map("provider_created_at")

  availability     TemplateAvailability @default(AVAILABLE)
  unavailableSince DateTime?            @map("unavailable_since")

  syncedAt  DateTime? @map("synced_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   MessagingChannel @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  campaigns Campaign[]
  messages  Message[]

  /// Idempotência da sincronização: rodar duas vezes não duplica.
  @@unique([workspaceId, provider, providerTemplateId])
  @@unique([channelId, name, language])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, availability])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

/// Resultado da avaliação de elegibilidade, preservado mesmo depois que o
/// `status` avança para SENT — é o que permite auditar por que alguém entrou.
enum RecipientStatus {
  PENDING
  ELIGIBLE
  /// Na lista de supressão. Separado de INELIGIBLE porque é o bloqueio de
  /// compliance mais importante e precisa ser contado à parte.
  SUPPRESSED
  /// Telefone inválido — também contado à parte para o relatório.
  INVALID
  /// Bloqueado por outro motivo: sem consentimento, variável ausente,
  /// template indisponível. O detalhe fica em `eligibilityReasons`.
  INELIGIBLE
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  CANCELLED
}

enum RecipientEligibility {
  NOT_EVALUATED
  ELIGIBLE
  BLOCKED
}

/// O que fazer quando uma variável obrigatória não tem valor para o contato.
enum MissingVariablePolicy {
  /// Padrão: o destinatário é bloqueado. Nunca se inventa conteúdo.
  BLOCK_RECIPIENT
  /// Usa o texto configurado explicitamente para aquela variável.
  FALLBACK_VALUE
}

enum CampaignStatus {
  DRAFT
  /// Materializando a audiência. Estado transitório que impede duas
  /// preparações simultâneas de correrem juntas.
  PREPARING
  /// Audiência materializada e avaliada; pronta para agendar ou iniciar.
  READY
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  channel    ChannelKind @default(WHATSAPP)
  channelId  String?     @map("channel_id")
  templateId String?     @map("template_id")

  /// Definição da audiência: listas, tags, cidades, consentimento, etc.
  /// É a ÚNICA fonte da seleção — não existe um `listId` paralelo que possa
  /// divergir dela.
  audienceFilters Json @default("{}") @map("audience_filters")

  /// Mapeamento das variáveis do template: { "body:1": { source, value } }.
  variableMap       Json                  @default("{}") @map("variable_map")
  /// O que fazer quando falta valor. O padrão bloqueia — nunca inventa texto.
  variablePolicy    MissingVariablePolicy @default(BLOCK_RECIPIENT) @map("variable_policy")
  /// Textos de fallback por variável, usados só com FALLBACK_VALUE.
  variableFallbacks Json                  @default("{}") @map("variable_fallbacks")

  /// Instante do disparo, sempre em UTC. `timezone` guarda a zona que o
  /// operador usou para escolher, para exibir de volta sem ambiguidade.
  scheduledAt DateTime? @map("scheduled_at")
  timezone    String    @default("UTC")

  preparedAt  DateTime? @map("prepared_at")
  startedAt   DateTime? @map("started_at")
  pausedAt    DateTime? @map("paused_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// Contadores desnormalizados: cache para a listagem. A VERDADE é a agregação
  /// sobre campaign_recipients (ver ADR 0016); `reconcileMetrics` os recalcula.
  totalRecipients      Int @default(0) @map("total_recipients")
  eligibleRecipients   Int @default(0) @map("eligible_recipients")
  suppressedRecipients Int @default(0) @map("suppressed_recipients")
  invalidRecipients    Int @default(0) @map("invalid_recipients")
  sentRecipients       Int @default(0) @map("sent_recipients")
  failedRecipients     Int @default(0) @map("failed_recipients")

  lastDryRunAt DateTime? @map("last_dry_run_at")

  failureReason String?  @map("failure_reason")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelRef MessagingChannel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  template   MessageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]
  messages   Message[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  campaignId  String          @map("campaign_id")
  contactId   String          @map("contact_id")
  status      RecipientStatus @default(PENDING)

  /// Resultado da avaliação, preservado mesmo depois que `status` avança.
  eligibility        RecipientEligibility @default(NOT_EVALUATED)
  /// Códigos do bloqueio: ["CONSENT_MISSING", "SUPPRESSED", …].
  eligibilityReasons String[]             @default([]) @map("eligibility_reasons")

  /// Deterministic key (campaignId:contactId:stepId) that makes retries safe.
  idempotencyKey String @map("idempotency_key")

  /// Valores das variáveis já resolvidos para este contato.
  variables       Json    @default("{}")
  /// Texto final que este contato receberia — o que o preview mostra.
  renderedPreview String? @map("rendered_preview")

  attemptCount Int       @default(0) @map("attempt_count")
  scheduledAt  DateTime? @map("scheduled_at")
  queuedAt     DateTime? @map("queued_at")
  sendingAt    DateTime? @map("sending_at")
  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  repliedAt    DateTime? @map("replied_at")
  failedAt     DateTime? @map("failed_at")
  cancelledAt  DateTime? @map("cancelled_at")

  /// `wamid` da mensagem enviada. Preenchido pela execução do Sprint 5.
  providerMessageId String? @map("provider_message_id")
  failureCode       String? @map("failure_code")
  failureReason     String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]

  /// Um contato não entra duas vezes na mesma campanha. Garantido no banco,
  /// não apenas no serviço.
  @@unique([campaignId, contactId])
  @@unique([idempotencyKey])
  @@index([campaignId, status])
  @@index([campaignId, eligibility])
  @@index([workspaceId, status])
  @@index([contactId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Conversations & messages
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  channelId     String             @map("channel_id")
  contactId     String             @map("contact_id")
  status        ConversationStatus @default(OPEN)
  assigneeId    String?            @map("assignee_id")
  unreadCount   Int                @default(0) @map("unread_count")
  lastMessageAt DateTime?          @map("last_message_at")
  lastInboundAt DateTime?          @map("last_inbound_at")
  closedAt      DateTime?          @map("closed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([channelId, contactId])
  @@index([workspaceId, status, lastMessageAt])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  /// Persistido ANTES da chamada ao provider. Se o processo morrer no meio, a
  /// tentativa fica visível em vez de desaparecer.
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  UNSUPPORTED
}

model Message {
  id                String           @id @default(cuid())
  workspaceId       String           @map("workspace_id")
  channelId         String           @map("channel_id")
  conversationId    String?          @map("conversation_id")
  contactId         String           @map("contact_id")
  campaignId        String?          @map("campaign_id")
  recipientId       String?          @map("recipient_id")
  templateId        String?          @map("template_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  status            MessageStatus    @default(QUEUED)
  body              String?
  /// Texto final, com as variáveis já substituídas — o que foi realmente
  /// enviado, e não o template.
  renderedContent   String?          @map("rendered_content")
  payload           Json             @default("{}")
  createdById       String?          @map("created_by_id")
  /// Chave de idempotência do envio. Duas submissões concorrentes da mesma
  /// intenção colidem na unique abaixo — a segunda perde no banco, não em uma
  /// checagem de leitura sujeita a corrida.
  idempotencyKey    String?          @map("idempotency_key")
  /// Provider-assigned id (e.g. Meta `wamid.*`). Unique per workspace so
  /// duplicated webhook deliveries cannot create a second row.
  providerMessageId String?          @map("provider_message_id")
  errorCode         String?          @map("error_code")
  errorTitle        String?          @map("error_title")
  errorMessage      String?          @map("error_message")
  /// Detalhe estruturado do erro do provider, já sanitizado.
  errorDetails      Json?            @map("error_details")

  /// Momento informado pelo provider, distinto de quando nós registramos.
  providerTimestamp DateTime? @map("provider_timestamp")

  /// Metadados de mídia recebida. O binário não é baixado nesta sprint.
  mediaId       String?     @map("media_id")
  mediaMimeType String?     @map("media_mime_type")
  mediaSha256   String?     @map("media_sha256")
  mediaFilename String?     @map("media_filename")
  mediaCaption  String?     @map("media_caption")
  mediaStatus   MediaStatus @default(NOT_APPLICABLE) @map("media_status")

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  failedAt    DateTime? @map("failed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      MessagingChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient    CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  template     MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, providerMessageId])
  @@unique([workspaceId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([workspaceId, status])
  @@index([campaignId, status])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Fila de trabalho
// ---------------------------------------------------------------------------

enum JobStatus {
  /// Esperando ser pego por um worker.
  PENDING
  /// Reservado por um worker até `leasedUntil`. Expirado o prazo, volta a ser
  /// elegível — um worker que morreu no meio não trava o job para sempre.
  LEASED
  DONE
  /// Falhou desta vez; será tentado de novo em `runAt`.
  FAILED
  /// Esgotou as tentativas ou falhou de forma não retentável. Fim da linha.
  DEAD
}

enum JobType {
  CAMPAIGN_SEND
}

/// Item de trabalho durável.
///
/// O `payload` carrega apenas IDENTIFICADORES. O worker relê tudo do banco
/// antes de agir: o conteúdo do job é um ponteiro, nunca a fonte da verdade.
model Job {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  type        JobType
  status      JobStatus @default(PENDING)
  payload     Json      @default("{}")

  /// Quando este job pode ser executado. É o que implementa tanto o
  /// agendamento quanto o backoff entre tentativas.
  runAt    DateTime @default(now()) @map("run_at")
  priority Int      @default(0)

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  /// Identifica o worker que reservou e até quando vale a reserva.
  leasedBy    String?   @map("leased_by")
  leasedUntil DateTime? @map("leased_until")

  lastError     String?   @map("last_error")
  lastErrorCode String?   @map("last_error_code")
  completedAt   DateTime? @map("completed_at")

  /// Enfileirar duas vezes a mesma intenção não cria dois jobs.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Índice do leasing: o worker busca por (status, runAt).
  @@index([status, runAt, priority])
  @@index([workspaceId, status])
  @@index([leasedUntil])
  @@map("jobs")
}

/// Token bucket de vazão, compartilhado entre processos.
///
/// O limitador em memória (`InMemoryRateLimiter`) é por processo e está
/// documentado como insuficiente para envio. Aqui o estado vive no banco, então
/// vários workers respeitam o MESMO teto.
///
/// Existe para respeitar o limite do provider e proteger a reputação do número.
/// NÃO é, e não deve virar, mecanismo de evasão de detecção.
model RateLimitBucket {
  /// Chave do balde, tipicamente `channel:<id>`.
  key         String @id
  workspaceId String @map("workspace_id")

  /// Tokens disponíveis agora e quando foram recalculados pela última vez.
  tokens        Float    @default(0)
  refilledAt    DateTime @default(now()) @map("refilled_at")
  /// Tokens por segundo e teto do balde.
  ratePerSecond Float    @default(10) @map("rate_per_second")
  burst         Float    @default(20)

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Webhooks & audit
// ---------------------------------------------------------------------------

enum WebhookEventStatus {
  /// Persistido, ainda não processado.
  RECEIVED
  /// Processamento em andamento. Existe para que um worker (Sprint 5) possa
  /// reclamar o evento sem que outro o pegue junto.
  PROCESSING
  PROCESSED
  FAILED
  /// Reconhecido, mas sem efeito a aplicar (tipo não suportado, canal
  /// desconhecido). Não é erro.
  IGNORED
}

/// Estado do arquivo de mídia de uma mensagem. O download em si não pertence
/// a esta sprint; os metadados são guardados para que ele possa acontecer.
enum MediaStatus {
  NOT_APPLICABLE
  NOT_YET_FETCHED
  FETCHED
  FAILED
}

/// Raw provider payload, stored before any processing. `providerEventId` is
/// unique per provider so redelivered events are dropped, not reprocessed.
model WebhookEvent {
  id              String             @id @default(cuid())
  workspaceId     String?            @map("workspace_id")
  provider        ChannelProvider    @default(META)
  providerEventId String             @map("provider_event_id")
  eventType       String?            @map("event_type")
  status          WebhookEventStatus @default(RECEIVED)
  /// Fragmento do evento + metadata da requisição, o bastante para reprocessar
  /// sozinho. Nunca contém cabeçalhos, assinatura ou credencial.
  payload         Json
  signatureValid  Boolean            @default(false) @map("signature_valid")
  receivedAt      DateTime           @default(now()) @map("received_at")
  processedAt     DateTime?          @map("processed_at")
  failedAt        DateTime?          @map("failed_at")
  errorMessage    String?            @map("error_message")
  createdAt       DateTime           @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String?  @map("workspace_id")
  actorUserId  String?  @map("actor_user_id")
  actorType    String   @default("USER") @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
